# Copy to .env and uncomment/set as needed. simd reads these at process start.

# -----------------------------------------------------------------------------
# Callbacks & notifications
# -----------------------------------------------------------------------------
# Optional: comma-separated hostnames or IPs allowed for callback URL (even if private / RFC1918).
# SIMULATION_CALLBACK_WHITELIST=

# Max optimization candidate_run_ids included in HTTP run payloads (0/unset = all retained candidates).
# Backend replay persistence can use this list when callback top_candidates is capped.
# SIMD_OPTIMIZATION_TOP_CANDIDATES=0

# Max candidate_run_ids listed in Notify callback JSON top_candidates (default 5; 0 = all).
# Use 5-10 for normal operation; use 0 when you want the backend to persist every retained candidate export.
# SIMD_CALLBACK_TOP_CANDIDATES=5

# -----------------------------------------------------------------------------
# Online optimization (server-side caps; durations are milliseconds)
# -----------------------------------------------------------------------------
# SIMD_SERVER_MAX_ONLINE_DURATION_MS=1800000
# SIMD_DEFAULT_MAX_ONLINE_DURATION_MS=600000
# SIMD_HEARTBEAT_REQUIRED_AFTER_MS=600000
# SIMD_SERVER_MAX_CONTROLLER_STEPS=
# SIMD_SERVER_MAX_CONCURRENT_ONLINE_RUNS=

# -----------------------------------------------------------------------------
# Simulation guardrails (Phase 1) — simd/limits.go + engine
# Durations use Go syntax: 30s, 5m, 1h
# -----------------------------------------------------------------------------
# SIMD_MAX_STANDARD_DURATION=30m
# SIMD_MAX_WALL_CLOCK_RUNTIME=15m
#
# Integer limits
# SIMD_MAX_EVENTS_SCHEDULED=2000000
# SIMD_MAX_EVENTS_PROCESSED=2000000
# SIMD_MAX_EVENT_QUEUE_SIZE=200000
# SIMD_MAX_REQUESTS_TRACKED=200000
# SIMD_MAX_TOTAL_REQUESTS=2000000
# SIMD_MAX_METRIC_POINTS=1000000
# SIMD_MAX_OPTIMIZATION_EVALUATIONS=1000

# -----------------------------------------------------------------------------
# Metrics collector (per-series bounds; internal/metrics/collector.go)
# SIMD_MAX_METRIC_SERIES_POINTS bounds timeline points per label series (default 256).
# SIMD_METRIC_RESERVOIR_SIZE bounds reservoir sampling for percentiles per series (default 1024).
# SIMD_MAX_METRIC_SERIES caps distinct label combinations (default 10000).
# -----------------------------------------------------------------------------
# SIMD_MAX_METRIC_SERIES_POINTS=256
# SIMD_METRIC_RESERVOIR_SIZE=1024
# SIMD_MAX_METRIC_SERIES=10000

# -----------------------------------------------------------------------------
# Engine: completed request traces & run latency reservoir (internal/engine/run.go)
# -----------------------------------------------------------------------------
# SIMD_MAX_COMPLETED_REQUEST_TRACES=1000
# SIMD_REQUEST_TRACE_SAMPLING_RATE=1.0
# SIMD_RUN_LATENCY_RESERVOIR_SIZE=2048

# -----------------------------------------------------------------------------
# RunStore lifecycle (Phase 5) — internal/simd/runstore.go
# -----------------------------------------------------------------------------
# SIMD_RUNSTORE_TTL=30m
# SIMD_RUNSTORE_CLEANUP_INTERVAL=1m
# SIMD_RUNSTORE_MAX_TERMINAL_RUNS=500
# SIMD_RUNSTORE_MAX_OPTIMIZATION_CANDIDATES=200
# Also accepts SIMD_OPTIMIZATION_MAX_RETAINED_CANDIDATES if the runstore-specific key is unset.
# SIMD_RUNSTORE_KEEP_COLLECTOR_AFTER_COMPLETION=false
# Retain optimization child input/final_config so top-candidate /export remains replayable for the backend.
# Default is true. Set false only when memory pressure matters more than replay/audit capture.
# SIMD_RUNSTORE_KEEP_CANDIDATE_INPUT_AFTER_CLEANUP=true

# -----------------------------------------------------------------------------
# Optimization safety (Phase 6) — internal/simd/optimization_limits.go and internal/improvement/safety.go
# -----------------------------------------------------------------------------
# SIMD_OPTIMIZATION_MAX_EVALUATIONS=128
# SIMD_OPTIMIZATION_MAX_ITERATIONS=20
# SIMD_OPTIMIZATION_MAX_CONCURRENT_CANDIDATES=2
# SIMD_OPTIMIZATION_MAX_WALL_CLOCK_RUNTIME=20m
# SIMD_OPTIMIZATION_CANDIDATE_MAX_WALL_CLOCK_RUNTIME=90s
# SIMD_OPTIMIZATION_MAX_FAILED_CANDIDATES=16
# SIMD_OPTIMIZATION_MAX_RETAINED_CANDIDATES=64
# SIMD_OPTIMIZATION_DEFAULT_EVALUATION_DURATION=10000
# SIMD_OPTIMIZATION_ALLOW_BATCH=true

# -----------------------------------------------------------------------------
# Scripts / local tooling (optional; not read by cmd/simd)
# -----------------------------------------------------------------------------
# REPO_ROOT=.
